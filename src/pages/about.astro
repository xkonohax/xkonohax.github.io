---
import Site from '../layouts/Site.astro';
import { PROFILE } from '../consts';
const skills=[['◎','Photography','Street, landscape, portrait'],['◈','Design','Visual identity, UI, print'],['▷','Video','Short films, documentary'],['✎','Writing','Essays, stories, criticism']];
---
<Site title="About — Alex"><main id="main" class="page about-grid"><div><div class="portrait"><img src={PROFILE.portrait} alt={PROFILE.name+' at work'} width="800" height="1000"/><div class="experience"><strong>6+</strong><small>Years of experience</small></div></div><div class="contact"><p>⌖ &nbsp;{PROFILE.location}</p><a href={'mailto:'+PROFILE.email}>✉ &nbsp;{PROFILE.email}</a></div></div>
<section><p class="eyebrow">About Me</p><h1>A creative mind living between frames &amp; words.</h1><div class="bio"><p>I'm {PROFILE.name}, a visual artist and writer based in Tokyo. My work spans photography, graphic design, short film, and written essays — all connected by a deep curiosity about beauty in everyday life.</p><p>I started with film photography in my early twenties and gradually expanded into digital design and video. Each medium teaches me something different about how we see and communicate.</p><p>This site is my personal space — a place to share the work I'm proud of and the ideas I'm exploring.</p></div><div class="skills">{skills.map(([icon,label,desc])=><div class="skill"><span aria-hidden="true">{icon}</span><div><strong>{label}</strong><small>{desc}</small></div></div>)}</div><div class="actions"><a class="button" href="/portfolio/">View Works</a><a class="button secondary" href="/blog/">Read Articles</a></div></section></main></Site>