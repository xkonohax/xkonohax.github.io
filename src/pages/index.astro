---
import Site from '../layouts/Site.astro';
import { PROFILE, SOCIAL_LINKS } from '../consts';
---
<Site><main id="main" class="hero"><div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
<div class="avatar"><img src={PROFILE.avatar} alt={PROFILE.name} width="96" height="96" fetchpriority="high"/><span aria-label="Available for work"></span></div>
<p class="eyebrow">Creative · Designer · Photographer</p><h1>Hi, I'm <span>{PROFILE.name}</span>.<br/>I create things worth seeing.</h1>
<p class="hero-description">I'm a visual artist and writer based in Tokyo. I capture moments, craft design, and share stories through my work and articles.</p>
<div class="actions"><a class="button" href="/portfolio/">View My Works</a><a class="button secondary" href="/blog/">Read Articles</a></div>
<div class="socials">{SOCIAL_LINKS.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>
<a class="down-arrow" href="/portfolio/" aria-label="Explore my works">↓</a></main></Site>