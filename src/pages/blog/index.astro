---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../../components/FormattedDate.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const tags=['All',...new Set(posts.flatMap(post=>post.data.tags))];
---
<Site title="Blog — Alex" background><main id="main" class="page"><div class="page-heading"><p class="eyebrow">Blog</p><h1>Articles &amp; Thoughts</h1><p>I write about creativity, design process, travel, and the stories behind my work.</p></div>
<div id="blog-filters" class="filters" aria-label="Filter articles">{tags.map(tag=><button data-tag={tag} aria-pressed={tag==='All'}>{tag}</button>)}</div><p id="article-count" class="sr-only" aria-live="polite"></p>
<div id="article-grid" class="article-grid">{posts.map((post,index)=><article class:list={['article-card',{'featured':index===0}]} data-tags={JSON.stringify(post.data.tags)}><a class="card-cover" href={'/blog/'+post.id+'/'} aria-label={'Read '+post.data.title}>{post.data.coverImage?<img src={post.data.coverImage} alt={post.data.title} loading="lazy"/>:post.data.heroImage&&<Image src={post.data.heroImage} width={1024} height={400} alt={post.data.title}/>}</a><div class="card-body"><div class="tags">{post.data.tags.map(tag=><span>{tag}</span>)}</div><h2><a href={'/blog/'+post.id+'/'}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="card-meta"><span>{Math.max(1,Math.ceil((post.body||'').split(/\s+/).length/200))} min read · <FormattedDate date={post.data.pubDate}/></span><a href={'/blog/'+post.id+'/'}>Read →</a></div></div></article>)}</div>
<p id="blog-empty" hidden>No articles with this tag yet.</p><section id="local-section" class="local-section" hidden><h2>On this device</h2><p>These articles are saved in this browser only.</p><div id="local-articles" class="article-grid"></div></section><p id="storage-status" role="status"></p>
</main></Site><script>import '../../scripts/blog';</script>