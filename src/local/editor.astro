---
import Site from '../layouts/Site.astro';
---
<Site title="Write — Alex"><main id="main" class="page editor"><a class="back-link" href="/blog/">← Back to articles</a><p class="eyebrow">Your next story</p><h1>Write an article</h1><p class="notice">Saved articles stay in this browser. Export Markdown to keep a copy or add it to your site's content folder for publication.</p><noscript><p class="no-js">Enable JavaScript to save and preview your writing.</p></noscript>
<form id="editor-form" class="editor-form"><label>Title<input name="title" required maxlength="200" placeholder="Give your story a title"/></label><label>Excerpt<textarea name="excerpt" required maxlength="1000" placeholder="A short introduction to your article"></textarea></label><label>Tags<input name="tags" placeholder="Photography, Creativity" maxlength="300"/></label><label>Cover image URL (optional)<input name="coverImage" type="url" placeholder="https://…"/></label><label>Your story<textarea name="content" required placeholder="Start writing…"></textarea></label><div class="actions"><button class="button" type="submit">Save article locally</button><button class="button secondary" id="preview-button" type="button">Preview text</button><button class="button secondary" id="export-button" type="button">Export Markdown</button></div><p id="editor-status" role="status" aria-live="polite"></p></form><section id="editor-preview" class="editor-preview" hidden><h2></h2><p class="plain-content"></p></section></main></Site><script>import '../scripts/editor';</script>
